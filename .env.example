# ============================================================================
# SyncDoc Environment Variables
# ============================================================================
# For Doppler users: export these via `doppler run -- docker compose up`
# For non-Doppler users: copy this file to `.env` and fill in your values.
# ============================================================================

# ============================================================================
# Database / Cache (For Local Development)
# ============================================================================
# Docker Compose will auto-create these. No changes needed for local `docker-compose up`
DATABASE_URL=postgresql+asyncpg://syncdoc:syncdoc_dev@postgres:5432/syncdoc
REDIS_URL=redis://redis:6379/0

# ============================================================================
# Runtime / URLs
# ============================================================================
ENVIRONMENT=development
PYTHONUNBUFFERED=1
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOW_SELF_REGISTER=false
ALLOW_RUNTIME_SETTINGS=false
ALLOW_LOCAL_SOURCES=false
ALLOWED_SOURCE_HOSTS=github.com,gitlab.com,bitbucket.org
ALLOW_PRIVATE_SOURCE_HOSTS=false
SOURCE_IMPORT_ROOT=

# Docker Hub deployment overrides used by docker-compose.prod.yml
APP_PORT=5174
API_PORT=8001
PROD_FRONTEND_URL=http://localhost:5174
PROD_BACKEND_URL=http://localhost:8001
SYNC_DOC_API_IMAGE=syncdocdev/syncdoc-api:latest
SYNC_DOC_FRONTEND_IMAGE=syncdocdev/syncdoc-frontend:latest
POSTGRES_PASSWORD=

# ============================================================================
# Authentication & Security
# ============================================================================
# For local development, this default is fine. Change for production deployments.
JWT_SECRET_KEY=your-secret-key-here-change-for-production
CREDENTIAL_ENCRYPTION_KEY=generate-a-separate-random-secret
GH_CLIENT_ID=
GH_CLIENT_SECRET=
GITHUB_PAT=

# ============================================================================
# LLM (Optional - AI Features)
# ============================================================================
# Leave LLM_API_KEY empty to disable AI features. To enable, add your own API key.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_ENDPOINT_URL=https://api.openai.com/v1

# ============================================================================
# Notifications
# ============================================================================
SLACK_WEBHOOK_URL=

# ============================================================================
# Email / SMTP
# ============================================================================
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@syncdoc.dev
EMAIL_FROM_NAME=SyncDoc
EMAIL_REPLY_TO=support@syncdoc.dev
REGISTRATION_NOTIFY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_EXPIRE_MINUTES=60

# If you send through Gmail but want the visible sender to be `@syncdoc.dev`,
# add that address as an authorized "Send mail as" alias in the sending mailbox.
